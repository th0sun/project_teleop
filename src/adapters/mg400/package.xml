<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mg400_adapter</name>
  <version>0.1.0</version>
  <description>
    Dobot MG400 adapter facade for the robot teaching architecture. This
    package wraps the existing mg400_controller runtime behind the
    robot_teaching_core adapter contracts.
  </description>
  <maintainer email="m.hassunofficial@gmail.com">th0sun</maintainer>
  <license>MIT</license>

  <exec_depend>mg400_controller</exec_depend>
  <exec_depend>mg400_protocol</exec_depend>
  <exec_depend>robot_teaching_core</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
